# Replicate API Key (For AI Image-to-Video generation)
REPLICATE_API_TOKEN=r8_your_replicate_api_key_here

# YouTube Data API v3 OAuth Credentials
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-your_client_secret
YOUTUBE_REFRESH_TOKEN=1//your_oauth_refresh_token

# Instagram Credentials (Graph API or Direct Login)
INSTAGRAM_USERNAME=your_instagram_handle
INSTAGRAM_PASSWORD=your_instagram_password
INSTAGRAM_ACCESS_TOKEN=EAAG...
INSTAGRAM_ACCOUNT_ID=17841...
